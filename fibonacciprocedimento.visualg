algoritmo "FibonacciProcedimento"
var
  I, T1, T2, T3 : Inteiro
Procedimento ProximoFibonacci(var N1, N2: Inteiro)
  var N3: Inteiro
  Inicio
    N3 <- N1 + N2
    Escreva (N3)
    N1 <- N2
    N2 <- N3
FimProcedimento
inicio
  T1 <- 0
  Escreva (T1 )
  T2 <- 1
  Escreva (T2)
  Para I de 3 ate 10 faca
    ProximoFibonacci(T1, T2)
  FimPara
FimAlgoritmo