algoritmo "valoresparesvetor"

var
  val: vetor [1..7] de inteiro
  i,TotPar: inteiro

inicio
  TotPar <- 0
  Para i de 1 ate 7 faca
    Escreval ("Digite o ", i, "o. valor: ")
    Leia (val[i])
    
  FimPara
  
  Para i de 1 ate 7 faca
    Se (val [i] mod 2 = 0) entao
      TotPar <- TotPar + 1
      Escreval ("Valor Par na Posicao ",i)
    Fimse
  FimPara
      Escreval ("O total de pares foi ", TotPar) 

fimalgoritmo