algoritmo "funcionario"

var
  nome: caractere
  sal, nsal : real
  dep: inteiro


inicio
  Escreval ("Qual o nome do funcionario? ")
  leia (nome)
  Escreval ("Qual o salario do funcionario? R$ ")
  leia (sal)
  Escreval ("Qual e a quantidade de dependentes? ")
  Leia (Dep)
  Escolha DEP
    Caso 0
      Nsal <- sal + (sal*5/100)
    Caso 1,2,3
      Nsal <- sal + (sal*10/100)
    Caso 4,5,6
      Nsal <- Sal + (Sal*15/100)
    Outrocaso
      Nsal <- Sal + (sal*18/100)
  Fimescolha
  Escreval ("O novo salario de ", nome , " sera de R$ ", nsal:5:2)
fimalgoritmo