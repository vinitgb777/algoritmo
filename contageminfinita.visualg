algoritmo "contageminfinita"

var
 contador: inteiro
 valor: inteiro
 salto: inteiro
inicio
    contador <- 0
    Escreval ("Quer contar até Quanto?")
    Leia (valor)
    Escreval ("Qual sera o valor do salto?")
    Leia (salto)
    Enquanto (contador <= valor) faca
    Escreval(contador)
      contador <- contador + salto
    Fimenquanto
    Escreval ("terminei de contar")
fimalgoritmo