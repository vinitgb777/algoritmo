algoritmo "somadornumerico"

var
  cont, n, s, menor: inteiro
inicio
  cont <- 1
  s <- 0
  Enquanto (cont <=5) faca
    Escreval ("Digite o " , cont, "o. valor : ")
    Leia (N)
    Se (cont = 1) entao
      menor <- n
    Fimse
    S <- S + N
    cont <- cont + 1
  FimEnquanto
  Escreval ("A soma de todos os valores foi ", S)
  Escreval ("O menor valor digitado foi ", menor)
fimalgoritmo