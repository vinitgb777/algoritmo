algoritmo "Fibonaccifuncao"
var
  I, T1, T2, T3 : Inteiro
Funcao ProximoFibonacci(var N1, N2: Inteiro): Inteiro
  var N3: Inteiro
  Inicio
    N3 <- N1 + N2
    N1 <- N2
    N2 <- N3
    Retorne (N3)
FimFuncao
inicio
  T1 <- 0
  Escreva (T1 )
  T2 <- 1
  Escreva (T2)
  Para I de 3 ate 5 faca
   T3 <- ProximoFibonacci(T1, T2)
   Escreval (T3)
  FimPara
FimAlgoritmo